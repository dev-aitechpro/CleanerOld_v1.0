<Window x:Class="CleanerProWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧹 Cleaner Pro — Нейрокод | Neuralis (Dev_Ai Tech)" 
        Height="620" Width="1000" 
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="🧹 ОЧИСТКА WINDOWS" FontSize="24" FontWeight="Bold" Foreground="#00BFFF" />
            <TextBlock Text=" by Нейрокод | Neuralis (Dev_Ai Tech)" FontSize="14" FontStyle="Italic" Foreground="#B0B0C0" Margin="12,0,0,0" Height="19">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="Foreground.(SolidColorBrush.Color)"
                                                From="#B0B0C0" To="#FF4081" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </StackPanel>

        <!-- Список задач -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <ItemsControl x:Name="TasksItemsControl" ItemsSource="{Binding Tasks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2A3E" CornerRadius="4" Margin="0,0,0,4" Padding="8,5" 
                                BorderBrush="#3A3A5E" BorderThickness="1"
                                MouseDown="TaskBorder_MouseDown">
                            <Border.Resources>
                                <Storyboard x:Key="HoverOn">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.1"/>
                                </Storyboard>
                                <Storyboard x:Key="HoverOff">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                                </Storyboard>
                            </Border.Resources>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.MouseEnter">
                                    <BeginStoryboard Storyboard="{StaticResource HoverOn}"/>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Border.MouseLeave">
                                    <BeginStoryboard Storyboard="{StaticResource HoverOff}"/>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected}" Grid.Column="0" Margin="0,0,12,0" Foreground="White" FontSize="12"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#64B5F6" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button Content="🔍 АНАЛИЗ" x:Name="BtnAnalyze" Click="BtnAnalyze_Click" 
                    Background="#1976D2" Foreground="White" Width="120" Height="36" 
                    FontWeight="Bold" FontSize="13" Margin="0,0,10,0" Cursor="Hand">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
                <Button.RenderTransform>
                    <ScaleTransform/>
                </Button.RenderTransform>
            </Button>
            <Button Content="🧹 ОЧИСТИТЬ" x:Name="BtnClean" Click="BtnClean_Click" 
                    Background="#2E7D32" Foreground="White" Width="120" Height="36" 
                    FontWeight="Bold" FontSize="13" Cursor="Hand">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
                <Button.RenderTransform>
                    <ScaleTransform/>
                </Button.RenderTransform>
            </Button>
        </StackPanel>

        <!-- Общий размер + прогресс -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding TotalSizeText}" FontSize="13" FontWeight="Bold" Foreground="#C0C0D0" VerticalAlignment="Center"/>
            <ProgressBar Grid.Column="1" x:Name="ProgressBar" Width="200" Height="16" 
                         Visibility="Collapsed" Foreground="#00BFFF" Background="#2A2A3E" VerticalAlignment="Center"/>
        </Grid>

        <!-- Лог -->
        <TextBox Grid.Row="4" x:Name="TxtLog" Height="80"
                 Background="#1E1E2E" Foreground="#C0C0D0" 
                 FontFamily="Consolas" FontSize="11" 
                 TextWrapping="Wrap" IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>

        <!-- Социальные сети -->
        <WrapPanel Grid.Row="5" Margin="0,0,0,2">
            <Button Content="Telegram" Tag="https://t.me/dev_aitech" 
                    Click="SocialButton_Click" Background="#3A3A5E" Foreground="White" 
                    Width="85" Height="26" Margin="0,0,4,0" Cursor="Hand" FontSize="10"/>
            <Button Content="Поддержать" Tag="https://boosty.to/kpavels1997/donate" 
                    Click="SocialButton_Click" Background="#3A3A5E" Foreground="White" 
                    Width="95" Height="26" Margin="0,0,4,0" Cursor="Hand" FontSize="10"/>
        </WrapPanel>

        <!-- Лицензия -->
        <TextBlock Grid.Row="6" 
                   Text="© 2026 Нейрокод | Neuralis (Dev_Ai Tech). Все права защищены. Коммерческое использование запрещено." 
                   FontSize="9" Foreground="#707080" HorizontalAlignment="Left"/>
    </Grid>
</Window>